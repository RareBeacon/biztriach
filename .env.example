# ─────────────────────────────────────────────────────────────
# Firebase (server) — from the service account key JSON
# Firebase Console → Project Settings → Service accounts → Generate new private key
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"

# ─────────────────────────────────────────────────────────────
# Firebase (browser) — from Project Settings → General → Your apps → Web app
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abc123"

# ─────────────────────────────────────────────────────────────
# AI Configuration (OpenRouter API)
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY="your-openrouter-api-key"
AI_MODEL="google/gemini-2.5-flash"

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Cloud API (optional)
WHATSAPP_VERIFY_TOKEN="biztriach_verify"
ADMIN_SETUP_KEY="change-me"

# Email (optional, for approval/welcome emails)
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
